# Backend env: the single source for uvicorn, scripts, and the Docker image.
#   cp backend/.env.example backend/.env
# Settings load .env from the directory you run in, so run uvicorn from backend/.
# Docker: docker run --env-file backend/.env bridge. Hosted: set these as service variables.
# With every value below left as is, the app runs fully offline: stub LLM, demo-data/ CSVs, in-memory runs.

APP_NAME=bridge-backend
# development uses the local Inngest dev server. staging and production use Inngest Cloud.
ENVIRONMENT=development
# Comma-separated. The Vite dev server's origin.
CORS_ORIGINS=http://localhost:5173

# --- Models ---
# stub: no key needed. The code pipeline still runs; model stages fall back to code.
# openai_compatible + LLM_API_KEY: real Nemotron calls on Nebius Token Factory.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# --- RAG embeddings ---
# Uses Nebius Qwen/Qwen3-Embedding-8B with 1,536 requested output dimensions. Empty key uses LLM_API_KEY only when
# LLM_BASE_URL points at Nebius Token Factory; otherwise embedding indexing stays lexical-only.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.tokenfactory.nebius.com/v1
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_INDEX_BATCH_SIZE=32
RAG_INDEX_LEASE_SECONDS=900

# Nemotron tiers on Token Factory (verified Oct 21 2026)
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Per-call timeouts in seconds, and JSON mode (response_format=json_object).
# Set LLM_JSON_RESPONSE_FORMAT=false if Token Factory rejects it.
LLM_TIMEOUT_NANO=30
LLM_TIMEOUT_SUPER=90
LLM_TIMEOUT_ULTRA=180
LLM_JSON_RESPONSE_FORMAT=true

# --- Data ---
# Empty: read demo-data/ and keep runs in memory (lost on restart).
# Set: Supabase transaction pooler URI (Connect > Transaction pooler, port 6543), migrated and seeded.
# Percent-encode special characters in the password (# -> %23, @ -> %40). Don't quote the value:
# docker --env-file keeps quotes literally.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATASET=northbrook-2026-10

# true: /api/v1 demo routes (reads, runs, decisions) work without sign-in as an anonymous demo user.
# A bearer token that is sent is still verified. false: those routes return 401 without a token.
PUBLIC_DEMO_API=true

# --- Supabase Auth (optional) ---
# Project origin and public key. The backend verifies each caller's JWT.
# Only the account routes (/auth/me, /profile, /chat) need them. Never use a secret/service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Inngest ---
# The Inngest SDK reads these from the process environment, not from this file, so they only
# take effect through docker --env-file or service variables.
# Docker with the dev server on the host:
#   INNGEST_DEV=http://host.docker.internal:8288
# Inngest Cloud (ENVIRONMENT=staging or production):
#   INNGEST_EVENT_KEY=
#   INNGEST_SIGNING_KEY=
#   INNGEST_ENV=          # branch environment name; leave unset for Production

# --- Scripts only ---
# scripts/smoke_nemotron.py reads LLM_API_KEY above.
