# Backend env: the single source for uvicorn, scripts, and the Docker image.
#   cp .env.example .env
# Settings load .env from the directory you run in, so run from backend/.
# Docker: docker run --env-file backend/.env bridge. Hosted: set these as service variables.

APP_NAME=bridge-backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# stub | openai_compatible
# For Nebius Token Factory set:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Nemotron tiers on Token Factory (verified Oct 21 2026)
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Supabase transaction pooler URI (Connect > Transaction pooler, port 6543).
# Percent-encode special characters in the password (# -> %23, @ -> %40). Don't quote the value:
# docker --env-file keeps quotes literally.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATASET=northbrook-2026-10

# true: /api/v1 demo routes (reads, runs, decisions) work without sign-in as an anonymous demo user.
# A bearer token that is sent is still verified. false: those routes return 401 without a token.
PUBLIC_DEMO_API=true

# Supabase project origin and public key. The backend verifies each caller's JWT.
# Never use a secret/service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
