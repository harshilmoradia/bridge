# Docker Compose settings only (docker compose up).
#   cp .env.example .env
# Backend env lives in backend/.env (see backend/.env.example).
# For `npm run dev`, use frontend/.env.local instead (see frontend/.env.example): Vite does not read this file.

# --- Frontend build args and dev-server env ---
# Dev / hot-reload overlay: the browser calls the API directly.
VITE_API_URL=http://localhost:8000
# Optional Supabase Auth. Set both or neither.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Compose ports (optional) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
