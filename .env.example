# Frontend and Compose settings. Backend env lives in backend/.env (see backend/.env.example).
#   cp .env.example .env

# --- Frontend ---
# Dev / hot-reload: browser calls the API directly.
# Prod image build uses an empty VITE_API_URL (same-origin).
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Compose ports (optional) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
