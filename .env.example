# Bridge — single source of truth for local + Docker Compose.
# Copy to .env and fill in secrets as needed:
#   cp .env.example .env

# --- Backend ---
APP_NAME=bridge-backend
ENVIRONMENT=development
# Prod Compose overrides this to the frontend origin (see docker-compose.yml).
CORS_ORIGINS=http://localhost:5173

# stub | openai_compatible
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Supabase project origin and public key. The backend verifies each caller's JWT.
# Never use a secret/service_role key here or in any VITE_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Frontend ---
# Dev / hot-reload: browser calls the API directly.
# Prod image build uses an empty VITE_API_URL (same-origin via nginx).
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Compose ports (optional) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
