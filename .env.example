# Bridge — single source of truth for local + Docker Compose.
# Copy to .env and fill in secrets as needed:
#   cp .env.example .env

# --- Backend ---
APP_NAME=bridge-backend
ENVIRONMENT=development
# Prod Compose overrides this to the frontend origin (see docker-compose.yml).
CORS_ORIGINS=http://localhost:5173

# stub | openai_compatible
# For Nebius Token Factory set:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
#   LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   (nano tier)
# Other Nemotron ids on Token Factory (verified Oct 21 2026):
#   nvidia/nemotron-3-super-120b-a12b   (super tier)
#   nvidia/Nemotron-3-Ultra-550b-a55b   (ultra tier)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Model tiers used by the agents (see docs/architecture.md)
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Database (Supabase) ---
# Transaction pooler URL (port 6543). Backend only; never expose to the browser.
DATABASE_URL=
DATASET=northbrook-2026-10

# --- Inngest ---
# Local: leave blank and run with INNGEST_DEV=1 plus the Inngest dev server.
# Production (ENVIRONMENT=production): set both from the Inngest Cloud dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Frontend ---
# Dev / hot-reload: browser calls the API directly.
# Prod image build uses an empty VITE_API_URL (same-origin via nginx).
VITE_API_URL=http://localhost:8000

# --- Compose ports (optional) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
