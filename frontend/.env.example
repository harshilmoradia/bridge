# Frontend env for `npm run dev` and `npm run build` run from this directory:
#   cp .env.example .env.local
# Vite reads env files from frontend/, not the repo root. The root .env only feeds Docker Compose.
# The single-container image builds with an empty VITE_API_URL (same origin) and no Supabase.

# The backend origin. Empty means same origin (/api on the host that served the UI).
VITE_API_URL=http://localhost:8000
# true serves JSON fixtures from src/api/fixtures, so the UI runs with no backend at all.
VITE_USE_MOCKS=false

# Optional Supabase Auth. Set both or neither; empty opens the demo workspace with no sign-in.
# Never put a secret/service_role key in a VITE_ variable (the build rejects one).
#   VITE_SUPABASE_URL=https://your-project-ref.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
